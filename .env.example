APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://your-app-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Recipient for operational alerts (e.g. `shopify:detect-orphaned-shops`) when
# no Slack/PagerDuty alerting stack is configured. Production deployments
# SHOULD set this — without it, orphaned-shop alerts only reach
# storage/logs/laravel.log (LOG_STACK=single below) and nobody will see them.
OPS_ALERT_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SHOPIFY_APP_NAME="TrackFlow"
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_SCOPES=read_pixels,write_pixels,read_customer_events
SHOPIFY_API_REDIRECT=/authenticate
# "webhook" must be included so the package's catch-all POST /webhook/{type}
# route (which dispatches App\Jobs\{Type}Job classes that mostly don't exist
# here) does not intercept our explicit Action-bound webhook routes in
# routes/web.php. Keep "home" so the SPA "/" route stays under our control too.
# "authenticate" documents intent so App\Actions\Shopify\AuthenticateShopify
# (routes/web.php) handles /authenticate instead of the package's own
# AuthController@authenticate — needed to bridge Shopify's
# managed-installation token exchange (id_token), see
# App\Actions\Shopify\AuthenticateShopify docblock. This is enforced even if
# "authenticate" is omitted here: App\Providers\AppServiceProvider force-adds
# it to the shopify-app.manual_routes config at boot time, so do not rely on
# this env value alone to keep the vendor route disabled.
SHOPIFY_MANUAL_ROUTES=home,webhook,authenticate

# "SPA" avoids the package's per-request MPA token-in-URL redirect dance
# (auth.token bridge) on every full navigation — our React app already fetches
# and attaches its own session token via App Bridge for actual API calls
# (resources/js/api/client.ts), so only already-installed full-page loads
# benefit from the SPA fast-path in VerifyShopify.
SHOPIFY_FRONTEND_TYPE=SPA

# Expiring offline tokens (Shopify deadline 2027-01-01). New installs must go
# straight through the expiring-token OAuth path. Legacy shops are migrated
# out-of-band via `php artisan shopify:migrate-offline-tokens` — keep
# auto-migrate disabled until the canary rollout is complete.
SHOPIFY_EXPIRING_OFFLINE_TOKENS=true
SHOPIFY_AUTO_MIGRATE_LEGACY=false

# Google OAuth client used for the per-shop "Connect with Google" flow on the
# GA4 settings page (App\Actions\Google\StartShopGoogleOAuth). Every shop
# connects its own Google account through this one OAuth client; the
# resulting refresh_token is stored on that shop's own PlatformIntegration
# row, not shared across shops. Unrelated to the per-shop GA4 Measurement
# Protocol credentials (measurement_id/api_secret) managed via /api/settings/ga4.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT=https://example.com/settings/ga4/google/callback
