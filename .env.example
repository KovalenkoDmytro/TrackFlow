APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://trackflow.growmeconsulting.ca

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Recipient for operational alerts (e.g. `shopify:detect-orphaned-shops`) when
# no Slack/PagerDuty alerting stack is configured. Production deployments
# SHOULD set this — without it, orphaned-shop alerts only reach
# storage/logs/laravel.log (LOG_STACK=single below) and nobody will see them.
OPS_ALERT_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SHOPIFY_APP_NAME="TrackFlow"
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_SCOPES=read_pixels,write_pixels,read_customer_events
SHOPIFY_API_REDIRECT=/authenticate
# "webhook" must be included so the package's catch-all POST /webhook/{type}
# route (which dispatches App\Jobs\{Type}Job classes that mostly don't exist
# here) does not intercept our explicit Action-bound webhook routes in
# routes/web.php. Keep "home" so the SPA "/" route stays under our control too.
SHOPIFY_MANUAL_ROUTES=home,webhook

# Expiring offline tokens (Shopify deadline 2027-01-01). New installs must go
# straight through the expiring-token OAuth path. Legacy shops are migrated
# out-of-band via `php artisan shopify:migrate-offline-tokens` — keep
# auto-migrate disabled until the canary rollout is complete.
SHOPIFY_EXPIRING_OFFLINE_TOKENS=true
SHOPIFY_AUTO_MIGRATE_LEGACY=false
